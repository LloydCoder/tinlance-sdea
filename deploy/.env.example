SDEA_DOMAIN=sdea.example.com
SDEA_ENVIRONMENT=production
SDEA_VERSION=0.1.0
SDEA_LOG_LEVEL=INFO
POSTGRES_DB=sdea
POSTGRES_USER=sdea
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://sdea:replace-with-a-long-random-secret@postgres:5432/sdea
REDIS_URL=redis://redis:6379/0
SDEA_QUEUE_NAME=sdea:jobs
